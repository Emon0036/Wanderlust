<% layout("/layout/boilerpelet") %>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">

      <h2 class="mb-4 text-center">Create a New Listing</h2>

      <form action="/listing" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">

        <div class="mb-3">
          <label class="form-label">Title</label>
          <input type="text" name="list[title]" class="form-control" placeholder="Enter title" required>
          <div class="valid-feedback">Looks good!</div>
        </div>

        <div class="mb-3">
          <label class="form-label">Description</label>
          <textarea name="list[description]" class="form-control" rows="4" placeholder="Enter description" required></textarea>
          <div class="invalid-feedback">Valid description required</div>
        </div>

        <div class="mb-3">
          <label class="form-label">Image</label>
          <input type="file" name="listingImage" class="form-control" required>
          <div class="invalid-feedback">Select an image file</div>
        </div>

        <div class="mb-3">
          <label class="form-label">Price</label>
          <input type="number" name="list[price]" class="form-control" placeholder="Enter price" required>
          <div class="invalid-feedback">Valid price required</div>
        </div>

        <div class="mb-3">
          <label class="form-label">Location</label>
          <input type="text" name="list[location]" class="form-control" placeholder="Enter location" required>
          <div class="invalid-feedback">Valid location required</div>
        </div>

        <div class="mb-4">
          <label class="form-label">Country</label>
          <input type="text" name="list[country]" class="form-control" placeholder="Enter country" required>
          <div class="invalid-feedback">Valid country required</div>
        </div>

        <button type="submit" class="btn btn-dark w-100">Add Listing</button>

      </form>

    </div>
  </div>
</div>