<% layout("/layout/boilerpelet") %>
<div class="container my-5">
   <div class="row justify-content-center">
      <div class="col-lg-6 col-md-8">

        
    <h2 class="mb-4 text-center">Update info</h2>
    <form action="/listing/<%=allinfo.id%>?_method=put" method="POST" enctype="multipart/form-data" novalidate class="needs-validation">

      <div  class="mb-3">
        <label for="title" class="form-title">Title</label>
        <input type="text" name="list[title]" class="form-control" value="<%=allinfo.title%>" required>
          <div class="valid-feedback">
      Looks good!
    </div>
      </div>

      <div  class="mb-3">
         <label for="description" class="form-description">Description</label>
         <textarea name="list[description]" class="form-control" required><%=allinfo.description%></textarea>
          <div class="invalid-feedback">
              Valid description required
            </div>
      </div>
 
 
      <div  class="mb-3">
        <label for="image" class="form-image" >Upload your image</label>
         <input type="file" name="listingImage" class="form-control" accept="image/*">
         <% if (allinfo.image && allinfo.image.url) { %>
            <div class="form-text">Leave empty to keep the current image.</div>
            <img src="<%=allinfo.image.url%>" alt="Current listing image" class="img-fluid rounded mt-2">
         <% } %>
      </div>


       <div  class="mb-3">
        <label for="price" class="form-price">Price</label>
        <input type="text" name="list[price]" class="form-control" value="<%=allinfo.price%>" required>
         <div class="invalid-feedback">
              Valid price required
            </div>
       </div>


        <div class="mb-3">
        <label for="location" class="form-location">Location</label>      
        <input type="text" name="list[location]" class="form-control" value="<%=allinfo.location%>" required>
         <div class="invalid-feedback">
              Valid location required
            </div>
       </div>

        <div  class="mb-3">
        <label for="country" class="form-location">Country</label>       
        <input type="text" name="list[country]" class="form-control" value="<%=allinfo.country%>" required>
         <div class="invalid-feedback">
              Valid location required
            </div>       
       </div>

        <button type="submit" class="btn btn-primary">update</button>
    </form>


      </div>
   </div>
    
</div>
